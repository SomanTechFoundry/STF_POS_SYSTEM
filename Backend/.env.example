PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://username:password@localhost:5432/stf_pos
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8080
APPROVAL_TO_EMAIL=you@example.com

# SMTP (optional)
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=your_smtp_user
#SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=you@example.com

# Optional Brevo API mode (recommended on Railway)
# If BREVO_API_KEY is set, SMTP_* is ignored for signup approval emails.
BREVO_API_KEY=your_brevo_api_key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
ADMIN_EMAIL=you@example.com
