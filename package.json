{
  "name": "stf-pos-system",
  "version": "1.0.0",
  "private": true,
  "description": "STF Point of Sale — Next.js modular monolith",
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "prisma generate && next build",
    "start": "next start --port 3002",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "node --env-file=.env.local --env-file=.env ./node_modules/prisma/build/index.js db push",
    "db:migrate": "node --env-file=.env.local --env-file=.env ./node_modules/prisma/build/index.js migrate dev",
    "db:migrate:prod": "node --env-file=.env.local --env-file=.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node --env-file=.env.local --env-file=.env ./node_modules/prisma/build/index.js studio",
    "db:seed": "node --env-file=.env.local --env-file=.env ./node_modules/prisma/build/index.js db seed"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
