# ============================================================
# STF POS System — Environment Variables
# Copy to .env.local for local development.
# NEVER commit .env.local (it is gitignored).
# ============================================================

# ---- Application ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ---- Database (Neon PostgreSQL + Prisma) ----
# Create a project at https://console.neon.tech
# Dashboard → Connection details:
#   - DATABASE_URL  = pooled connection (Prisma Client at runtime)
#       often includes ?sslmode=require and -pooler in the host
#   - DIRECT_URL    = direct connection (Prisma Migrate / db push)
#       same DB, host WITHOUT -pooler
#
# Example shapes (replace with your Neon values):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://username:password@host/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@host/neondb?sslmode=require"

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string_at_least_10_chars
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@example.com

# Optional seed overrides (used by npm run db:seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# ---- Signup approval email (optional for local) ----
# If Brevo/SMTP are missing, approve URLs are logged to the server console.
APPROVAL_TO_EMAIL=admin@example.com
SMTP_FROM_EMAIL=noreply@example.com
# BREVO_API_KEY=
# BREVO_API_URL=https://api.brevo.com/v3/smtp/email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
